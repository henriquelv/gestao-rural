# Supabase Configuration
# Copie este arquivo para .env.local e preencha com suas credenciais
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua_chave_anon_aqui
VITE_APP_VERSION=1.0.16-risk-hardening-hotfix
VITE_EXPECTED_SUPABASE_REF=vocnftkhnrfnbfvpnqtb

# PIN administrativo local para ações protegidas no app.
# Observação: por estar no frontend, isso não substitui RLS/backend para segurança forte.
VITE_ADMIN_PIN=troque_este_pin

# Dados demonstrativos embutidos. Deixe false no app real.
VITE_ENABLE_SEED_DATA=false

# Código secreto do dono do app.
# Quem digitar este código na tela de ativação entra no modo Dono (painel completo de fazendas).
# NUNCA compartilhar. Definir apenas no .env.local, nunca commitar o valor real.
VITE_OWNER_CODE=

# Gemini API (opcional - para funcionalidades de IA)
# Se não usar IA, pode deixar vazio
VITE_GEMINI_API_KEY=sua_chave_gemini_aqui
